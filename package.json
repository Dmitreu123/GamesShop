{
  "name": "games-shop",
  "version": "1.0.0",
  "description": "Games Shop — маркетплейс игровых товаров",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
